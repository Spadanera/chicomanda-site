---
import Base from '../layouts/Base.astro'
import DecoIcon from '../components/DecoIcon.astro'
import { SITE } from '../site'
import { LIMITS } from '../../shared/demo-form.ts'

const mailto = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent('Richiesta demo Chi Comanda')}`
---
<Base
    title="Richiedi una demo"
    description="Chiedi una demo di Chi Comanda per il tuo locale, o scrivici per qualsiasi domanda: ti rispondiamo noi."
>
    <section class="section container demo-grid">
        <div class="intro">
            <span class="eyebrow">Demo e contatti</span>
            <h1>Vediamolo sul tuo locale</h1>
            <p class="lead">
                Raccontaci qualcosa del tuo locale: ti ricontattiamo per mostrarti Chi Comanda con i tuoi tavoli e il
                tuo menu, oppure per rispondere alle tue domande.
            </p>
            <ul class="points" role="list">
                <li><DecoIcon name="mdi-check" /> Demo guidata, senza impegno</li>
                <li><DecoIcon name="mdi-check" /> Un’installazione dedicata con il nome e i colori del tuo locale</li>
                <li><DecoIcon name="mdi-check" /> Si usa dai telefoni che lo staff ha già</li>
            </ul>
            <p class="alt">
                Preferisci l’email? Scrivici a <a href={mailto}>{SITE.contactEmail}</a>.
            </p>
        </div>

        <form class="card form" id="modulo" method="post" action="/api/demo" data-demo-form>
            <fieldset class="topic">
                <legend>Di cosa hai bisogno?</legend>
                <label class="choice">
                    <input type="radio" name="topic" value="demo" checked />
                    <span>Una demo</span>
                </label>
                <label class="choice">
                    <input type="radio" name="topic" value="info" />
                    <span>Informazioni</span>
                </label>
            </fieldset>

            <div class="field">
                <label for="name">Nome e cognome</label>
                <input id="name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} />
            </div>
            <div class="field">
                <label for="venue">Locale</label>
                <input id="venue" name="venue" type="text" autocomplete="organization" required maxlength={LIMITS.venue} />
            </div>
            <div class="row">
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" autocomplete="email" required maxlength={LIMITS.email} />
                </div>
                <div class="field">
                    <label for="phone">Telefono <span class="optional">(facoltativo)</span></label>
                    <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength={LIMITS.phone} />
                </div>
            </div>
            <div class="field">
                <label for="message">Messaggio</label>
                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    maxlength={LIMITS.message}
                    placeholder="Che locale hai, quanti tavoli, quando ti farebbe comodo sentirci…"
                ></textarea>
            </div>

            <!-- Honeypot: hidden from people and screen readers, bots fill it in -->
            <div class="trap" aria-hidden="true">
                <label for="website">Non compilare questo campo</label>
                <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <label class="consent">
                <input type="checkbox" name="consent" value="yes" required />
                <span>
                    Ho letto l’<a href="/privacy">informativa privacy</a> e acconsento al trattamento dei miei dati
                    per essere ricontattato.
                </span>
            </label>

            <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-language="it" data-size="flexible"></div>

            <noscript>
                <p class="notice">
                    La verifica antispam richiede JavaScript. Se non puoi attivarlo, scrivici a{' '}
                    <a href={mailto}>{SITE.contactEmail}</a>.
                </p>
            </noscript>

            <p class="notice error" data-form-error hidden role="alert"></p>

            <button class="btn btn-primary submit" type="submit">Invia la richiesta</button>
        </form>
    </section>

    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script define:vars={{ contactEmail: SITE.contactEmail }}>
        // Progressive enhancement: send in place and show errors next to the button.
        // Without JavaScript the form posts normally and the Function redirects.
        const form = document.querySelector('[data-demo-form]')
        const errorBox = form.querySelector('[data-form-error]')
        const button = form.querySelector('button[type=submit]')

        const MESSAGES = {
            dati: 'Controlla i campi del modulo.',
            verifica: 'La verifica antispam non è riuscita. Riprova tra qualche secondo.',
            invio: 'Non siamo riusciti a inviare la richiesta.',
        }

        function showError(outcome, details) {
            const data = new FormData(form)
            const body = [
                `Nome: ${data.get('name') || ''}`,
                `Locale: ${data.get('venue') || ''}`,
                `Telefono: ${data.get('phone') || ''}`,
                '',
                data.get('message') || '',
            ].join('\n')
            const href = `mailto:${contactEmail}?subject=${encodeURIComponent('Richiesta demo Chi Comanda')}&body=${encodeURIComponent(body)}`
            errorBox.replaceChildren()
            errorBox.append(`${MESSAGES[outcome] || MESSAGES.invio} `)
            if (details && details.length) errorBox.append(`(${details.join(', ')}) `)
            const link = document.createElement('a')
            link.href = href
            link.textContent = `Scrivici a ${contactEmail}`
            errorBox.append('Puoi anche ', link, ': il messaggio è già pronto.')
            errorBox.hidden = false
        }

        form.addEventListener('submit', async event => {
            event.preventDefault()
            errorBox.hidden = true
            button.disabled = true
            button.textContent = 'Invio in corso…'
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { Accept: 'application/json' },
                })
                const result = await response.json().catch(() => ({ ok: false, outcome: 'invio' }))
                if (result.ok) {
                    location.assign('/demo/grazie')
                    return
                }
                showError(result.outcome, result.errors)
                if (result.outcome === 'verifica' && window.turnstile) window.turnstile.reset()
            } catch {
                showError('invio')
            }
            button.disabled = false
            button.textContent = 'Invia la richiesta'
        })
    </script>
</Base>

<style>
    .demo-grid {
        display: grid;
        gap: 40px;
        align-items: start;
    }

    @media (min-width: 900px) {
        .demo-grid {
            grid-template-columns: .9fr 1.1fr;
            gap: 64px;
        }
    }

    .lead {
        font-size: 1.15rem;
        color: var(--ink-soft);
    }

    .points {
        list-style: none;
        padding: 0;
        margin: 24px 0;
        display: grid;
        gap: 10px;
    }

    .points li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .points :global(svg) {
        color: var(--secondary);
        margin-top: 2px;
    }

    .alt {
        color: var(--ink-soft);
    }

    .alt a {
        overflow-wrap: anywhere;
    }

    .form {
        display: grid;
        gap: 18px;
        padding: clamp(20px, 4vw, 32px);
        background: var(--surface-bright);
        box-shadow: var(--shadow);
    }

    .topic {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        border: 0;
        margin: 0;
        padding: 0;
    }

    .topic legend {
        width: 100%;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .choice {
        position: relative;
    }

    .choice input {
        position: absolute;
        opacity: 0;
        inset: 0;
        margin: 0;
        cursor: pointer;
    }

    .choice span {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 8px 18px;
        border: 1.5px solid var(--line-strong);
        border-radius: 999px;
    }

    .choice input:checked + span {
        background: var(--primary);
        border-color: var(--primary);
        color: var(--on-primary);
    }

    .choice input:focus-visible + span {
        outline: 3px solid var(--ochre);
        outline-offset: 2px;
    }

    .row {
        display: grid;
        gap: 18px;
    }

    @media (min-width: 560px) {
        .row {
            grid-template-columns: 1fr 1fr;
        }
    }

    .field {
        display: grid;
        gap: 6px;
    }

    .field label {
        font-weight: 600;
    }

    .optional {
        font-weight: 400;
        color: var(--ink-soft);
    }

    input[type=text],
    input[type=email],
    input[type=tel],
    textarea {
        width: 100%;
        min-height: 48px;
        padding: 12px 14px;
        border: 1.5px solid var(--line-strong);
        border-radius: 10px;
        background: var(--bg);
        color: var(--ink);
        font: inherit;
    }

    textarea {
        resize: vertical;
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 25%, transparent);
    }

    .trap {
        position: absolute;
        left: -10000px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .consent {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: .95rem;
    }

    .consent input {
        width: 22px;
        height: 22px;
        margin-top: 2px;
        flex: none;
        accent-color: var(--primary);
    }

    .notice {
        margin: 0;
        padding: 12px 14px;
        border-radius: 10px;
        background: color-mix(in srgb, var(--ochre) 18%, transparent);
    }

    .notice.error {
        background: color-mix(in srgb, var(--error) 15%, transparent);
    }

    .submit {
        justify-self: start;
    }

    @media (max-width: 559px) {
        .submit {
            width: 100%;
        }
    }
</style>
