---
import Base from '../../layouts/Base.astro'
import Logo from '../../components/Logo.astro'
import { SITE } from '../../site'

const mailto = `mailto:${SITE.contactEmail}?subject=${encodeURIComponent('Richiesta demo Chi Comanda')}`
---
<Base
    title="Richiesta non inviata"
    description="Non siamo riusciti a inviare la tua richiesta: scrivici via email."
    noindex
>
    <section class="section container message">
        <Logo size={120} eager />
        <div class="rule" aria-hidden="true"><span></span></div>
        <h1>La richiesta non è partita</h1>
        <p>
            Qualcosa non ha funzionato: un campo mancante, la verifica antispam o un problema nostro.
            Scrivici direttamente a <a href={mailto}>{SITE.contactEmail}</a>, oppure riprova.
        </p>
        <div class="actions">
            <a class="btn btn-primary" href={mailto}>Scrivici una email</a>
            <a class="btn btn-ghost" href="/demo">Torna al modulo</a>
        </div>
    </section>
</Base>

<style>
    .message {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .message p {
        max-width: 560px;
        color: var(--ink-soft);
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }
</style>
