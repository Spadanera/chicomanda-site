---
import Base from '../layouts/Base.astro'
import Logo from '../components/Logo.astro'
import DecoIcon from '../components/DecoIcon.astro'
import { SITE } from '../site'
import '../styles/fields.css'
---
<Base
    title="Accedi al tuo locale"
    description="Entra nell’app Chi Comanda del tuo locale: scrivi il nome del locale e ti portiamo alla pagina di accesso."
>
    <section class="section container login-page">
        <div class="card panel" data-login data-app-domain={SITE.appDomain}>
            <Logo size={96} eager />
            <h1>Accedi al tuo locale</h1>

            <div class="remembered" data-remembered hidden>
                <a class="btn btn-primary wide" href="#" data-remembered-link>
                    <span>Entra in <span data-remembered-name></span></span>
                    <DecoIcon name="mdi-arrow-right" size={20} />
                </a>
                <button type="button" class="link-button" data-forget>Non è il tuo locale? Cambia</button>
            </div>

            <form class="venue-form" method="get" action="/accedi" data-venue-form novalidate>
                <div class="md-field">
                    <input
                        class="md-field__input"
                        id="locale"
                        name="locale"
                        type="text"
                        inputmode="url"
                        autocomplete="off"
                        autocapitalize="none"
                        spellcheck="false"
                        required
                        maxlength="60"
                        placeholder="nome"
                        aria-describedby="locale-suffix locale-help locale-status"
                    />
                    <label class="md-field__label" for="locale">Il tuo locale</label>
                    <span class="md-field__suffix" id="locale-suffix">.{SITE.appDomain}</span>
                </div>
                <p class="md-field__message status" id="locale-status" data-status role="status" aria-live="polite"></p>
                <p class="md-field__message" id="locale-help">
                    È l’indirizzo che usate per l’app, per esempio <strong>libra</strong>.{SITE.appDomain}.
                </p>
                <button class="btn btn-primary wide" type="submit">Continua</button>
            </form>

            <noscript>
                <p class="status">
                    Senza JavaScript scrivi direttamente l’indirizzo del locale nel browser:
                    <strong>nome-del-locale.{SITE.appDomain}</strong>
                </p>
            </noscript>

            <p class="note">
                Il tuo locale non usa ancora Chi Comanda? <a href="/demo">Richiedi una demo</a>.
            </p>
        </div>
    </section>
</Base>

<script>
    import { displayName, normalizeSlug, slugProblem, type SlugProblem } from '../../shared/slug.ts'

    const STORAGE_KEY = 'chicomanda:lastVenue'
    const TIMEOUT_MS = 6000

    const root = document.querySelector<HTMLElement>('[data-login]')!
    const appDomain = root.dataset.appDomain!
    const form = root.querySelector<HTMLFormElement>('[data-venue-form]')!
    const input = form.querySelector<HTMLInputElement>('input[name=locale]')!
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    const status = root.querySelector<HTMLElement>('[data-status]')!
    const remembered = root.querySelector<HTMLElement>('[data-remembered]')!

    const PROBLEMS: Record<SlugProblem, string> = {
        empty: 'Scrivi il nome del locale.',
        invalid: 'Il nome può contenere solo lettere, numeri e trattini, da 2 a 30 caratteri.',
        reserved: 'Questo non è il nome di un locale.',
    }

    const loginUrl = (slug: string) => `https://${slug}.${appDomain}/login`

    const storage = {
        get: () => { try { return localStorage.getItem(STORAGE_KEY) } catch { return null } },
        set: (slug: string) => { try { localStorage.setItem(STORAGE_KEY, slug) } catch { /* not remembered */ } },
        clear: () => { try { localStorage.removeItem(STORAGE_KEY) } catch { /* nothing to clear */ } },
    }

    function say(message: string, kind: 'info' | 'error' = 'info') {
        status.textContent = message
        status.dataset.kind = kind
        input.setAttribute('aria-invalid', String(kind === 'error'))
    }

    /**
     * Does the venue exist? A no-cors request to its health endpoint: the answer is opaque, but a subdomain
     * that doesn't exist fails at DNS, so we can say "not found" instead of leaving the person on the
     * browser's error page. Nothing about other venues is ever listed.
     */
    async function venueExists(slug: string) {
        try {
            await fetch(`https://${slug}.${appDomain}/api/health`, {
                mode: 'no-cors',
                cache: 'no-store',
                credentials: 'omit',
                signal: AbortSignal.timeout(TIMEOUT_MS),
            })
            return true
        } catch {
            return false
        }
    }

    async function go(raw: string) {
        const slug = normalizeSlug(raw, appDomain)
        const problem = slugProblem(slug)
        if (problem) {
            say(PROBLEMS[problem], 'error')
            input.focus()
            return
        }
        if (input.value !== slug) input.value = slug
        button.disabled = true
        say(`Cerco ${slug}.${appDomain}…`)
        if (!(await venueExists(slug))) {
            button.disabled = false
            say(`Locale non trovato: controlla il nome (${slug}.${appDomain}) o chiedilo al tuo responsabile.`, 'error')
            input.focus()
            return
        }
        storage.set(slug)
        say(`Ti porto a ${displayName(slug)}…`)
        location.assign(loginUrl(slug))
    }

    form.addEventListener('submit', event => {
        event.preventDefault()
        go(input.value)
    })

    input.addEventListener('input', () => {
        if (status.dataset.kind === 'error') say('')
    })

    root.querySelector('[data-forget]')!.addEventListener('click', () => {
        storage.clear()
        remembered.hidden = true
        input.focus()
    })

    // Direct link: /accedi?locale=libra (e-mails, QR codes)
    const requested = new URLSearchParams(location.search).get('locale')
    const last = storage.get()
    if (requested) {
        input.value = requested
        go(requested)
    } else if (last && !slugProblem(last)) {
        const link = remembered.querySelector<HTMLAnchorElement>('[data-remembered-link]')!
        link.href = loginUrl(last)
        remembered.querySelector('[data-remembered-name]')!.textContent = displayName(last)
        remembered.hidden = false
    }
</script>

<style>
    .login-page {
        display: grid;
        place-items: center;
        min-height: calc(100vh - 69px - 220px);
    }

    .panel {
        display: grid;
        justify-items: center;
        gap: 16px;
        width: 100%;
        max-width: 480px;
        padding: clamp(24px, 5vw, 40px);
        text-align: center;
        background: var(--surface-bright);
        box-shadow: var(--shadow);
    }

    h1 {
        font-size: clamp(1.8rem, 5vw, 2.4rem);
        margin: 0;
    }

    .remembered {
        display: grid;
        gap: 8px;
        width: 100%;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line);
    }

    .remembered[hidden] {
        display: none;
    }

    .wide {
        width: 100%;
    }

    .link-button {
        justify-self: center;
        min-height: 44px;
        padding: 8px;
        border: 0;
        background: none;
        color: var(--primary);
        font: inherit;
        text-decoration: underline;
        text-underline-offset: .18em;
        cursor: pointer;
    }

    .venue-form {
        display: grid;
        gap: 0;
        width: 100%;
        text-align: left;
    }

    .venue-form .md-field__input {
        text-align: right;
    }

    .venue-form .btn {
        margin-top: 12px;
    }

    .status {
        font-size: .875rem;
    }

    .status[data-kind="error"] {
        font-weight: 500;
    }

    .note {
        margin: 8px 0 0;
        font-size: .95rem;
        color: var(--ink-soft);
    }
</style>
