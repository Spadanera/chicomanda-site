---
import Base from '../layouts/Base.astro'
import Logo from '../components/Logo.astro'
import DecoIcon from '../components/DecoIcon.astro'
import { SITE } from '../site'

// Every function below exists in the app's code (chi-comanda). Deliberately NOT promised: fiscal receipts /
// registratore telematico (not implemented), offline use (the service worker has no cache), the cocktail "premium"
// option (too niche for the home page).
const features = [
    {
        icon: 'mdi-walk',
        title: 'Ordini al tavolo dal telefono',
        text: 'Il cameriere sceglie il tavolo e ordina dal menu dell’evento, senza blocchetti e senza passare dal bancone.',
    },
    {
        icon: 'mdi-send-check',
        title: 'Bar e cucina',
        text: 'Ogni prodotto va alla sua destinazione, che configuri tu. Il bartender vede solo le sue comande, con un avviso se un ordine aspetta da troppi minuti.',
    },
    {
        icon: 'mdi-cash-register',
        title: 'Cassa',
        text: 'I consumi di ogni tavolo a colpo d’occhio, pagamenti parziali, sconti e pagamenti elettronici con SumUp.',
    },
    {
        icon: 'mdi-bell-ring',
        title: 'Notifiche push',
        text: 'I bartender ricevono una notifica sul telefono a ogni nuovo ordine, anche con lo schermo spento.',
    },
    {
        icon: 'mdi-message-fast',
        title: 'Messaggi allo staff',
        text: 'Un avviso a tutti durante la serata: “manca il ghiaccio”, “tavolo 12 chiede il conto”.',
    },
    {
        icon: 'mdi-table-chair',
        title: 'Mappa dei tavoli',
        text: 'Sale e tavoli disegnati come nel locale, con zoom e stato aggiornato in tempo reale su ogni dispositivo.',
    },
    {
        icon: 'mdi-book-open-variant',
        title: 'Menu per evento',
        text: 'Un menu diverso per ogni serata, e la consumazione minima da addebitare al tavolo quando serve.',
    },
    {
        icon: 'mdi-shield-crown',
        title: 'Ruoli e personalizzazione',
        text: 'Ognuno vede solo quello che gli serve. Ogni locale ha la sua installazione, con nome, logo e colori propri, e si installa come app sul telefono.',
    },
] as const

const steps = [
    {
        title: 'Prepari il locale',
        text: 'Sale e tavoli sulla mappa, prodotti e menu, destinazioni come bar e cucina, e lo staff con il suo ruolo.',
    },
    {
        title: 'Apri la serata',
        text: 'Crei l’evento e scegli il menu: da quel momento lo staff lo vede sul telefono.',
    },
    {
        title: 'Si prendono gli ordini',
        text: 'Il cameriere ordina al tavolo; ogni prodotto arriva subito al bancone o in cucina giusti.',
    },
    {
        title: 'Si chiude il conto',
        text: 'In cassa trovi i consumi del tavolo: incassi tutto o una parte, in contanti o con SumUp.',
    },
] as const

const roles = [
    { icon: 'mdi-walk', title: 'Cameriere', text: 'Tavoli, menu della serata e ordini.' },
    { icon: 'mdi-glass-cocktail', title: 'Bar e cucina', text: 'Solo le comande della propria destinazione, in ordine di arrivo.' },
    { icon: 'mdi-cash', title: 'Cassa', text: 'Conti dei tavoli, sconti e pagamenti.' },
    { icon: 'mdi-shield-crown', title: 'Amministratore', text: 'Eventi, menu, tavoli, staff e impostazioni del locale.' },
] as const

const audiences = [
    { icon: 'mdi-glass-cocktail', title: 'Bar e cocktail bar' },
    { icon: 'mdi-pizza', title: 'Ristoranti e pizzerie' },
    { icon: 'mdi-glass-flute', title: 'Discoteche e locali con tavoli' },
    { icon: 'mdi-glass-mug-variant', title: 'Feste e sagre' },
] as const

const structuredData = [
    {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: SITE.name,
        url: SITE.url,
        description: SITE.description,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web, Android, iOS',
        inLanguage: 'it',
    },
]
---
<Base title={SITE.name} description={SITE.description} structuredData={structuredData}>
    <section class="hero">
        <div class="container hero-grid">
            <div class="hero-copy">
                <span class="eyebrow">Comande per bar e locali</span>
                <h1>Le comande del tuo locale, dal tavolo al bancone.</h1>
                <p class="lead">
                    Chi Comanda porta gli ordini dal telefono del cameriere al bar e alla cucina, tiene i conti dei
                    tavoli per la cassa e mostra a ciascuno solo quello che gli serve.
                </p>
                <div class="cta-row">
                    <a class="btn btn-primary" href="/demo">Richiedi una demo</a>
                    <a class="btn btn-ghost" href="/accedi">Accedi al tuo locale</a>
                </div>
            </div>

            <div class="hero-art" aria-hidden="true">
                <div class="sunburst"></div>
                <Logo size={200} class="hero-logo" eager />
                <div class="ticket ticket-order">
                    <p class="ticket-head"><span>Tavolo 12</span><span>Sala</span></p>
                    <ul>
                        <li><span>2 × Negroni</span><span class="dest">Bar</span></li>
                        <li><span>1 × Spritz</span><span class="dest">Bar</span></li>
                        <li><span>1 × Tagliere</span><span class="dest">Cucina</span></li>
                    </ul>
                </div>
                <div class="ticket ticket-alert">
                    <DecoIcon name="mdi-bell-ring" size={20} />
                    <span>Nuovo ordine · Tavolo 12</span>
                </div>
            </div>
        </div>
    </section>

    <section class="section features-section" id="funzioni" aria-labelledby="funzioni-title">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Funzioni</span>
                <h2 id="funzioni-title">Tutto il servizio, su un telefono</h2>
                <p>Dal primo ordine al conto, ogni passaggio arriva subito a chi deve occuparsene.</p>
            </div>
            <ul class="features" role="list">
                {features.map(feature => (
                    <li class="card feature">
                        <span class="icon-badge"><DecoIcon name={feature.icon} size={28} /></span>
                        <h3>{feature.title}</h3>
                        <p>{feature.text}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section steps-section" id="come-funziona" aria-labelledby="come-title">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Come funziona</span>
                <h2 id="come-title">Quattro passi, ogni sera</h2>
            </div>
            <ol class="steps" role="list">
                {steps.map((step, index) => (
                    <li class="step">
                        <span class="step-number">{index + 1}</span>
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="section" id="ruoli" aria-labelledby="ruoli-title">
        <div class="container two-col">
            <div class="section-head">
                <span class="eyebrow">Ruoli</span>
                <h2 id="ruoli-title">Ognuno vede il suo</h2>
                <p>
                    Lo staff entra con il proprio account e trova solo le schermate del suo ruolo: niente menu
                    inutili nel momento di massimo lavoro.
                </p>
            </div>
            <ul class="roles" role="list">
                {roles.map(role => (
                    <li class="role">
                        <DecoIcon name={role.icon} size={28} />
                        <div>
                            <h3>{role.title}</h3>
                            <p>{role.text}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section audience-section" id="per-chi" aria-labelledby="per-chi-title">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Per chi è</span>
                <h2 id="per-chi-title">Pensato per chi lavora al tavolo</h2>
            </div>
            <ul class="audiences" role="list">
                {audiences.map(audience => (
                    <li class="card audience">
                        <DecoIcon name={audience.icon} size={36} />
                        <span>{audience.title}</span>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section final-cta" aria-labelledby="demo-title">
        <div class="container final-inner">
            <Logo size={88} />
            <div class="rule" aria-hidden="true"><span></span></div>
            <h2 id="demo-title">Vuoi vederlo all’opera?</h2>
            <p>Ti mostriamo Chi Comanda sul tuo menu e sui tuoi tavoli, senza impegno.</p>
            <a class="btn btn-primary" href="/demo">Richiedi una demo</a>
        </div>
    </section>
</Base>

<style>
    /* ── Hero ───────────────────────────────────────────────────────── */
    .hero {
        padding-block: clamp(40px, 8vw, 96px);
        overflow: hidden;
    }

    .hero-grid {
        display: grid;
        gap: 48px;
        align-items: center;
    }

    @media (min-width: 900px) {
        .hero-grid {
            grid-template-columns: 1.1fr .9fr;
        }
    }

    .lead {
        font-size: clamp(1.1rem, 2.2vw, 1.3rem);
        color: var(--ink-soft);
        max-width: 560px;
    }

    .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .hero-art {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 360px;
        max-width: 460px;
        width: 100%;
        margin-inline: auto;
    }

    .sunburst {
        position: absolute;
        inset: 0;
        margin: auto;
        width: min(100%, 420px);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
            radial-gradient(circle, var(--bg) 0 31%, transparent 31.5%),
            repeating-conic-gradient(from 0deg, color-mix(in srgb, var(--ochre) 55%, transparent) 0 1.2deg, transparent 1.2deg 10deg);
        mask: radial-gradient(circle, #000 0 62%, transparent 70%);
        -webkit-mask: radial-gradient(circle, #000 0 62%, transparent 70%);
        opacity: .9;
    }

    .hero-art :global(.hero-logo) {
        position: relative;
        width: clamp(160px, 40vw, 200px);
        height: clamp(160px, 40vw, 200px);
    }

    .ticket {
        position: absolute;
        background: var(--surface-bright);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        font-size: .875rem;
    }

    .ticket-order {
        right: 0;
        bottom: 4px;
        width: 210px;
        padding: 12px 14px;
    }

    .ticket-head {
        display: flex;
        justify-content: space-between;
        margin: 0 0 8px;
        padding-bottom: 6px;
        border-bottom: 1px dashed var(--line-strong);
        font-size: .75rem;
        font-weight: 500;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .ticket ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 4px;
    }

    .ticket li {
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .dest {
        color: var(--secondary);
        font-weight: 600;
    }

    .ticket-alert {
        left: 0;
        top: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        color: var(--ink);
    }

    .ticket-alert :global(svg) {
        color: var(--ochre);
    }

    @media (max-width: 420px) {
        .ticket-order {
            width: 190px;
        }
    }

    /* ── Features ───────────────────────────────────────────────────── */
    .features-section {
        background: var(--surface);
        border-block: 1px solid var(--line);
    }

    .features,
    .audiences,
    .roles,
    .steps {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .features {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    }

    .feature {
        background: var(--bg);
    }

    .feature p {
        margin: 0;
        color: var(--ink-soft);
    }

    .icon-badge {
        display: inline-grid;
        place-items: center;
        width: 52px;
        height: 52px;
        margin-bottom: 14px;
        border-radius: 50%;
        border: 1px solid var(--line-strong);
        color: var(--primary);
        position: relative;
    }

    .icon-badge::after {
        content: "";
        position: absolute;
        right: 2px;
        top: 2px;
        width: 7px;
        height: 7px;
        background: var(--ochre);
        transform: rotate(45deg);
    }

    /* ── Steps ──────────────────────────────────────────────────────── */
    .steps {
        display: grid;
        gap: 28px;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
        counter-reset: step;
    }

    .step {
        position: relative;
        padding-top: 20px;
        border-top: 1px solid var(--line-strong);
    }

    .step p {
        color: var(--ink-soft);
        margin: 0;
    }

    .step-number {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 12px;
        border-radius: 50%;
        background: var(--primary);
        color: var(--on-primary);
        font-size: 1.25rem;
        font-weight: 500;
    }

    /* ── Roles ──────────────────────────────────────────────────────── */
    .two-col {
        display: grid;
        gap: 24px;
    }

    @media (min-width: 900px) {
        .two-col {
            grid-template-columns: 1fr 1fr;
            gap: 64px;
            align-items: start;
        }
    }

    .roles {
        display: grid;
        gap: 0;
    }

    .role {
        display: flex;
        gap: 16px;
        padding-block: 18px;
        border-bottom: 1px solid var(--line);
    }

    .role:first-child {
        border-top: 1px solid var(--line);
    }

    .role :global(svg) {
        color: var(--primary);
        margin-top: 2px;
    }

    .role h3 {
        margin-bottom: 4px;
    }

    .role p {
        margin: 0;
        color: var(--ink-soft);
    }

    /* ── Audience ───────────────────────────────────────────────────── */
    .audience-section {
        background: var(--surface);
        border-block: 1px solid var(--line);
    }

    .audiences {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    }

    .audience {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--bg);
        font-size: 1.0625rem;
        font-weight: 500;
    }

    .audience :global(svg) {
        color: var(--secondary);
    }

    /* ── Final CTA ──────────────────────────────────────────────────── */
    .final-inner {
        display: grid;
        justify-items: center;
        text-align: center;
    }

    .final-inner p {
        color: var(--ink-soft);
        max-width: 520px;
    }
</style>
