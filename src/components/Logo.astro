---
import logoLight from '../assets/logo/maitre-light.svg?url'
import logoDark from '../assets/logo/maitre-dark.svg?url'

/**
 * The maître logo, light or dark version following the site theme. Two <img> rather than inline SVG:
 * both files use the same ids (patterns, clip paths), which would collide in one document.
 */
interface Props {
    size?: number
    class?: string
    /** Above the fold: load it eagerly. */
    eager?: boolean
}

const { size = 48, class: className, eager = false } = Astro.props
const loading = eager ? 'eager' : 'lazy'
---
<span class:list={['logo', className]} style={`--logo-size:${size}px`}>
    <img class="logo-light" src={logoLight} alt="" width={size} height={size} loading={loading} decoding="async" />
    <img class="logo-dark" src={logoDark} alt="" width={size} height={size} loading={loading} decoding="async" />
</span>

<style>
    .logo {
        display: inline-block;
        width: var(--logo-size);
        height: var(--logo-size);
        flex: none;
    }

    .logo img {
        width: 100%;
        height: 100%;
    }

    .logo-dark {
        display: none;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .logo-light {
            display: none;
        }

        :global(:root:not([data-theme="light"])) .logo-dark {
            display: block;
        }
    }

    :global(:root[data-theme="dark"]) .logo-light {
        display: none;
    }

    :global(:root[data-theme="dark"]) .logo-dark {
        display: block;
    }
</style>
