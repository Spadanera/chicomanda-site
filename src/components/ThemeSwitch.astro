---
import DecoIcon from './DecoIcon.astro'
---
<button type="button" class="theme-switch" data-theme-switch aria-label="Cambia tema">
    <DecoIcon name="mdi-weather-night" class="when-light" />
    <DecoIcon name="mdi-weather-sunny" class="when-dark" />
</button>

<script>
    // The initial theme is set by the inline script in <head>; this only toggles and remembers it.
    const root = document.documentElement
    const isDark = () => root.dataset.theme
        ? root.dataset.theme === 'dark'
        : matchMedia('(prefers-color-scheme: dark)').matches

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-switch]')) {
        const label = () => button.setAttribute('aria-label', isDark() ? 'Passa al tema chiaro' : 'Passa al tema scuro')
        label()
        button.addEventListener('click', () => {
            const next = isDark() ? 'light' : 'dark'
            root.dataset.theme = next
            try { localStorage.setItem('theme', next) } catch { /* private mode: not remembered */ }
            label()
        })
    }
</script>

<style>
    .theme-switch {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
        border: 1px solid var(--line-strong);
        border-radius: 50%;
        background: transparent;
        color: var(--ink);
        cursor: pointer;
    }

    .theme-switch:hover {
        border-color: var(--ink);
    }

    .theme-switch :global(.when-dark) {
        display: none;
    }

    @media (prefers-color-scheme: dark) {
        :global(:root:not([data-theme="light"])) .theme-switch :global(.when-light) {
            display: none;
        }

        :global(:root:not([data-theme="light"])) .theme-switch :global(.when-dark) {
            display: block;
        }
    }

    :global(:root[data-theme="dark"]) .theme-switch :global(.when-light) {
        display: none;
    }

    :global(:root[data-theme="dark"]) .theme-switch :global(.when-dark) {
        display: block;
    }
</style>
